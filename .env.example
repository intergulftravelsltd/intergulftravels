# Copy this file to .env.local and fill in real values. See SETUP.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin emails (comma separated). Staff/admins sign in at /admin.
ADMIN_EMAILS=hellointergulftravelsltd@gmail.com

# SMS gateway (khudebarta.com masking SMS) — optional server-side fallback.
# Agencies normally enter these under Admin → SMS → SMS Settings instead.
KHUDEBARTA_API_KEY=
KHUDEBARTA_SECRET_KEY=
KHUDEBARTA_SENDER_ID=
# KHUDEBARTA_API_URL=https://portal.khudebarta.com:3770
