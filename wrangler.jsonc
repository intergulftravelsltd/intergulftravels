{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intergulftravels",
  // Cloudflare account "Itsinjamul@gmail.com's Account" (Workers Paid).
  "account_id": "961c0fbc26e6f6f58a857aa66d45a781",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Keep the *.workers.dev URL alive next to the custom domains (handy for checks).
  "workers_dev": true,
  "preview_urls": false,
  // Supabase lives in Tokyo: smart placement runs the worker near it, so the
  // admin pages' many sequential queries stay fast from Bangladesh.
  "placement": { "mode": "smart" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "intergulftravels" }],
  // ISR / SSG page cache (Workers KV).
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "20b4adee5c5c4c0897b4438eaf14ff20" }],
  // revalidateTag() bookkeeping: one tiny table, one indexed read per cached page.
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "intergulftravels-tags", "database_id": "f4663366-3350-4a9a-ba2b-f3e606426f7c" }
  ],
  // next/image optimisation + the admin's image uploads (WebP / signature PNG).
  "images": { "binding": "IMAGES" },
  "vars": {
    "NEXTJS_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://intergulftravelsltd.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://vwgoaqiijotowzouvdsc.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_OvNQEjqwmaoPIMnd4P8MbQ_zhnMNcoU"
  }
}
